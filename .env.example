# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials. See middleware/db_connection.py for
# how these are consumed.
#
# IMPORTANT: if this password ever gets pasted somewhere it shouldn't
# (chat, a doc, a Slack message), rotate it in your provider's
# dashboard. Pasting a credential anywhere outside a secrets manager
# should be treated as "this credential is now compromised."

PGHOST=your-db-host.example.com
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
PGSSLMODE=require

# Set explicitly rather than relying on the PGPORT==6543 guess in
# middleware/db_connection.py if you know your actual pooling mode:
# PGBOUNCER_TRANSACTION_MODE=true

# RabbitMQ (queue/producer.py, queue/consumer.py)
QUEUE_HOST=localhost

# Local LLM serving (ai-assistant/llm_service/local_llm_client.py)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
